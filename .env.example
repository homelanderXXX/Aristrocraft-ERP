# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL & Storage configuration (Phase 3A)
# These allow client-side connection to the Supabase backend.
# In production / Coolify deployment, configure these in the environment settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth 2.0 Client ID (for Google Sign In / GSI popup)
# Create a Web Client ID in Google Cloud Console Credentials
VITE_GOOGLE_CLIENT_ID=16113429439-6kbmqr6dvpgsiopfibv36h2v8l91r41d.apps.googleusercontent.com

# Firebase Authentication & Client Configuration (aristrocrafts)
VITE_FIREBASE_API_KEY=AIzaSyCDkEMoH5rIXZU9pBbi5PeMMxal57yDKqE
VITE_FIREBASE_AUTH_DOMAIN=aristrocrafts.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aristrocrafts

# Dolibarr ERP Configuration (Legacy)
# Connects AristroCraft directly to self-hosted Dolibarr instance
DOLIBARR_API_URL=
DOLIBARR_API_KEY=

# ERPNext Integration Configuration (Active)
# Connects AristroCraft directly to your self-hosted Frappe / ERPNext instance
ERPNEXT_URL=https://erpnext.ovisoft.tech
ERPNEXT_API_KEY=a60ae72ff6f8cbb
ERPNEXT_API_SECRET=8c5d0aa43865737
ERPNEXT_COMPANY=Aristro Craft


